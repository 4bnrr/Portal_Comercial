PORT=3000
CVCRM_DOMAIN=estacao1
CVCRM_EMAIL=abner.silva@estacao1construtora.com.br
CVCRM_TOKEN=
CVCRM_SYNC_MINUTES=60

CVCRM_REQUEST_GAP_MS=3200

# false = oculta empreendimentos sem situação comercial atual
CVCRM_SHOW_SOLD_OUT_ENTERPRISES=false

CVCRM_PHASE_GAP_MS=0
CVCRM_429_COOLDOWN_MS=60000
CVCRM_AUTO_SYNC=true

CVCRM_STARTUP_SYNC_DELAY_MS=30000

# Vercel: defina um segredo aleatório com pelo menos 16 caracteres.
# A Vercel envia esse valor automaticamente no agendamento configurado em vercel.json.
CRON_SECRET=

# Criado automaticamente ao conectar um armazenamento Vercel Blob privado ao projeto.
BLOB_READ_WRITE_TOKEN=
VERCEL_CATALOG_BLOB_PATH=estacao1/catalog.json
